{
  "model": "claude-sonnet-5[1m]",
  "enabledPlugins": {
    "habblaud@habblaud": true,
    "habblaud-permissoes@habblaud": true,
    "habblaud-mensagens@habblaud": true,
    "superpowers@anthropic-plugin-directory": true
  },
  "extraKnownMarketplaces": {
    "habblaud": {
      "source": {
        "source": "directory",
        "path": "/home/nathan/habblaud"
      }
    }
  },
  "spinnerTipsEnabled": true,
  "modelSettings": {
    "claude-sonnet-5-5": {
      "effortLevel": "medium"
    }
  },
  "theme": "auto",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); path=$(printf '%s' \"$payload\" | jq -r '.tool_input.file_path // empty'); if printf '%s' \"$path\" | grep -qiE '(^|/)\\.env($|\\.)|\\.pem$|\\.key$|id_rsa|id_ed25519|\\.p12$|\\.pfx$|credentials$|\\.kube/config|msal_token_cache|\\.azure/.*\\.(json|bin)$'; then echo \"Blocked: '$path' may contain secrets. Ask the user for explicit confirmation before reading this file.\" >&2; exit 2; fi; exit 0"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "payload=$(cat); cmd=$(printf '%s' \"$payload\" | jq -r '.tool_input.command // empty'); if printf '%s' \"$cmd\" | grep -qiE 'terraform +(apply|destroy)|kubectl.*delete|rm +-rf|git +push +--force|git +reset +--hard|git +clean +-[a-z]*f'; then echo '{\"hookSpecificOutput\":{\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"Destructive command detected. Confirm before running.\"}}'; fi; exit 0"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "github-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "REPLACE_WITH_GITHUB_PAT"
      }
    },
    "atlassian": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.atlassian.com/v1/sse"
      ]
    },
    "eks-dev": {
      "command": "uvx",
      "args": [
        "awslabs.eks-mcp-server@latest",
        "--allow-sensitive-data-access"
      ],
      "env": {
        "AWS_PROFILE": "development-us",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "eks-hml": {
      "command": "uvx",
      "args": [
        "awslabs.eks-mcp-server@latest",
        "--allow-write",
        "--allow-sensitive-data-access"
      ],
      "env": {
        "AWS_PROFILE": "homologation-us",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "autoApprove": [
        "manage_k8s_resource"
      ]
    },
    "eks-prd": {
      "command": "uvx",
      "args": [
        "awslabs.eks-mcp-server@latest",
        "--allow-sensitive-data-access"
      ],
      "env": {
        "AWS_PROFILE": "production-us",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "awslabs.aws-documentation-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "awslabs.aws-network-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.aws-network-mcp-server@latest"
      ],
      "env": {
        "AWS_PROFILE": "network-us",
        "AWS_REGION": "us-east-1",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "awslabs.cloudwatch-mcp-server": {
      "command": "uvx",
      "args": [
        "awslabs.cloudwatch-mcp-server@latest"
      ],
      "env": {
        "AWS_PROFILE": "REPLACE_WITH_AWS_PROFILE",
        "FASTMCP_LOG_LEVEL": "ERROR"
      }
    },
    "splunk-mcp-combined": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "REPLACE_WITH_YOUR_SPLUNK_MCP_URL"
      ]
    }
  },
  "_note_mcp_prerequisites": "The eks-*/awslabs.* servers run via `uvx` (from astral's `uv`) \u2014 install it first (https://docs.astral.sh/uv/) or they'll fail with 'spawn uvx ENOENT', same as they currently do under your real Kiro config (checked ~/.kiro/logs/*/mcp.log). `awslabs.cloudwatch-mcp-server` has no single right AWS_PROFILE across dev/hml/prd in the source config \u2014 set REPLACE_WITH_AWS_PROFILE yourself. `splunk-mcp-combined` is a private/enterprise MCP server reached over HTTP in your real Kiro setup (streamable-http transport, not a public package) \u2014 no public URL exists to guess, so REPLACE_WITH_YOUR_SPLUNK_MCP_URL with your org's real endpoint before this entry will work.",
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:4141",
    "ANTHROPIC_AUTH_TOKEN": "dummy",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-5-5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "false",
    "CLAUDE_CODE_AUTO_MODE_SERVER": "0",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  }
}