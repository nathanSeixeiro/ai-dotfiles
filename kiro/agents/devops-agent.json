{
  "name": "devops-agent",
  "description": "DevOps agent (MyOrg) — EKS/AKS, Terraform, GitOps, GitHub. Read-first, write via CLI.",
  "tools": [
    "@awslabs.cloudwatch-mcp-server",
    "@eks-dev",
    "@eks-hml",
    "@eks-prd",
    "@github-mcp",
    "introspect",
    "knowledge",
    "read",
    "shell",
    "subagent",
    "todo_list",
    "web",
    "write"
  ],
  "includeMcpJson": true,
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "shell",
        "effect": "allow",
        "match": [
          "grep *",
          "find *",
          "head *",
          "tail *",
          "cat *",
          "less *",
          "wc *",
          "ls *",
          "tree *",
          "file *",
          "stat *",
          "du *",
          "df *",
          "which *",
          "whoami",
          "hostname",
          "uname *",
          "env",
          "echo *",
          "pwd",
          "realpath *",
          "dirname *",
          "basename *",
          "sort *",
          "uniq *",
          "awk *",
          "sed *",
          "diff *",
          "jq *",
          "yq *",
          "mkdir *",
          "sleep *",
          "python3 *",
          "base64 *",
          "xxd *",
          "curl *",
          "aws sso login",
          "aws sts get-caller-identity",
          "kubectl --context eks-dev *",
          "kubectl --context eks-hml *",
          "kubectl --context eks-prod *",
          "kubectl --context aks-dvp *",
          "kubectl --context aks-hml *",
          "kubectl --context aks-prd *",
          "kubectl --context kind-clt *",
          "git status *",
          "git log *",
          "git diff *",
          "git branch *",
          "git remote *",
          "git show *",
          "git add *",
          "git commit *",
          "git push *",
          "git pull *",
          "git stash *",
          "git fetch *",
          "git rebase *",
          "git checkout *",
          "git switch *",
          "gh pr *",
          "gh issue *",
          "gh repo *",
          "gh run *",
          "gh workflow *",
          "gh api *",
          "gh auth *",
          "terraform init *",
          "terraform validate *",
          "terraform plan *",
          "terraform fmt *",
          "az login",
          "az account *",
          "az keyvault secret list *",
          "az keyvault secret show *",
          "grep",
          "find",
          "head",
          "tail",
          "cat",
          "less",
          "wc",
          "ls",
          "tree",
          "file",
          "stat",
          "du",
          "df",
          "which",
          "uname",
          "echo",
          "realpath",
          "dirname",
          "basename",
          "sort",
          "uniq",
          "awk",
          "sed",
          "diff",
          "jq",
          "yq",
          "mkdir",
          "sleep",
          "python3",
          "base64",
          "xxd",
          "curl",
          "kubectl --context eks-dev",
          "kubectl --context eks-hml",
          "kubectl --context eks-prod",
          "kubectl --context aks-dvp",
          "kubectl --context aks-hml",
          "kubectl --context aks-prd",
          "kubectl --context kind-clt",
          "git status",
          "git log",
          "git diff",
          "git branch",
          "git remote",
          "git show",
          "git add",
          "git commit",
          "git push",
          "git pull",
          "git stash",
          "git fetch",
          "git rebase",
          "git checkout",
          "git switch",
          "gh pr",
          "gh issue",
          "gh repo",
          "gh run",
          "gh workflow",
          "gh api",
          "gh auth",
          "terraform init",
          "terraform validate",
          "terraform plan",
          "terraform fmt",
          "az account",
          "az keyvault secret list",
          "az keyvault secret show"
        ]
      },
      {
        "capability": "shell",
        "effect": "deny",
        "match": [
          "terraform apply *",
          "terraform destroy *",
          "kubectl * delete *",
          "rm -rf *",
          "sudo *",
          "git push --force *",
          "git reset --hard *",
          "git clean -f*"
        ]
      },
      {
        "capability": "mcp",
        "effect": "allow",
        "match": [
          "eks-dev/*",
          "eks-hml/manage_k8s_resource",
          "github-mcp/*",
          "awslabs.cloudwatch-mcp-server/*"
        ]
      },
      {
        "capability": "skill",
        "effect": "allow"
      },
      {
        "capability": "web_fetch",
        "effect": "allow"
      },
      {
        "capability": "web_search",
        "effect": "allow"
      },
      {
        "capability": "subagent",
        "effect": "allow",
        "match": [
          "aws-specialist"
        ]
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  },
  "prompt": "# devops-agent\nDevOps agent for my-org. Follow the steering files.\n\n## AWS consultant\nAWS question (account, VPC/TGW/SG/route, IAM, EKS control plane, ECR, S3, ElastiCache, CloudFront/WAF/ALB in network-us, cost): spawn subagent `aws-specialist` with the question, env(s) and what you already know. It answers read-only with evidence. It never changes anything: the change stays with the owner agent.\n"
}